model GameMode {
  id                      String              @id @default(uuid())
  title                   String
  description             String?
  
  sceneQueryConfig        SceneQueryConfig?
  
  playTimeEstimateMinutes Int?
  rewardMultiplier        Float?
  order                   Int

  sessions                GameSession[]
  
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  @@map("game_modes")
}